{% extends 'layout.html.twig' %}

{# Overview based on the App\TaskList\SummarizedTaskList read model. #}
{% block content %}
    {{ include('tasks/_list_header.html.twig') }}

    <div class="row mt-4">
        {% for list in lists %}
            <div class="col-md-4">
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            <a href="{{ path('tasklist_show', {id: list.id}) }}">{{ list.name|title }}</a>
                            {% if list.archived %}<span class="badge text-bg-secondary">archived</span>{% endif %}
                        </h5>
                        <p class="card-text">list with {{ list.taskCount }} tasks</p>

                        <div class="d-flex justify-content-between align-items-baseline">
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('tasklist_show', {id: list.id}) }}">show</a>
                            <small class="text-body-secondary">
                                {% if list.updated is not null %}
                                    last updated {{ list.updated|date('d.m.Y H:i') }}
                                {% else %}
                                    created {{ list.created|date('d.m.Y H:i') }}
                                {% endif %}
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <p class="text-body-secondary">You have no lists yet.</p>
        {% endfor %}
    </div>
{% endblock %}
