{% extends 'layout.html.twig' %}

{% block content %}
    {{ include('tasks/_list_header.html.twig') }}

    <div class="row mt-4">
        {% for task_list in task_lists %}
            <div class="col-md-4">
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title"><a href="{{ path('tasklist_show', {id: task_list.id}) }}">{{ task_list.title|title }}</a></h5>
                        <p class="card-text">list with {{ task_list.items|length }} tasks</p>

                        <div class="d-flex justify-content-between align-items-baseline">
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('tasklist_show', {id: task_list.id}) }}">show</a>
                            <small class="text-body-secondary">
                                {% if task_list.lastUpdatedOn is not null %}
                                    last updated {{ task_list.lastUpdatedOn|date('d.m.Y H:i') }}
                                {% else %}
                                    created {{ task_list.createdOn|date('d.m.Y H:i') }}
                                {% endif %}
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <p class="text-body-secondary">No lists found.</p>
        {% endfor %}
    </div>
{% endblock %}
